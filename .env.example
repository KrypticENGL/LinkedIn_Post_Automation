# ---------------------------------------------------------------------------
# Core
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=3000
# Public HTTPS base URL of this service. Used to build the LinkedIn OAuth
# redirect URI and the /health endpoint an uptime pinger hits.
PUBLIC_BASE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Database  (Neon / Supabase / local Postgres)
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require

# ---------------------------------------------------------------------------
# Google Gemini (post copy, topic curation, safety moderation)
# Free tier, no credit card: https://aistudio.google.com/apikey
# Note: on the free tier Google may use submitted content to improve their
# products. Move to the paid tier if that is not acceptable for your client.
# ---------------------------------------------------------------------------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.7-flash
# Used only when the primary model's safety filters decline a request.
GEMINI_FALLBACK_MODEL=gemini-3.5-flash

# Your tier's rate limits, used only to work out the "quota left" figures shown by
# /test — Google publishes no endpoint that reports remaining quota, so these are
# compared against the calls this bot recorded. Current values for your tier:
# https://ai.google.dev/gemini-api/docs/rate-limits
GEMINI_FREE_RPM=10
GEMINI_FREE_RPD=250

# ---------------------------------------------------------------------------
# Post writing (optional — defaults to Gemini)
#
# Set POST_WRITER=claude to write and revise posts on a Claude Pro/Max
# subscription instead of the Gemini free tier. Nothing else moves: topic
# curation and both moderation checks stay on Gemini, because the safety gate
# needs vision and this route has no image input.
#
# Get the token by running `claude setup-token` once, on a machine with a
# browser. It lasts a year, authenticates as your subscription, and is read
# from the environment — so it survives Render deploys and cold starts.
#
# Two things to know:
#   - Never set ANTHROPIC_API_KEY alongside it. The API key wins the SDK's
#     credential order and posts would silently bill a metered API account.
#     The app refuses to boot if both are present.
#   - Anthropic's Consumer Terms restrict automated access to the subscription
#     outside the documented CI/scripting carve-out. Read §3 and decide for
#     yourself; POST_WRITER=gemini is the default for that reason.
# ---------------------------------------------------------------------------
POST_WRITER=gemini
CLAUDE_CODE_OAUTH_TOKEN=
CLAUDE_CODE_MODEL=claude-sonnet-5

# ---------------------------------------------------------------------------
# Image generation (free providers)
#   pollinations  -> https://pollinations.ai  (no API key required)
#   huggingface   -> FLUX.1-schnell on the HF Inference API (free tier, needs a token)
# ---------------------------------------------------------------------------
IMAGE_PROVIDER=pollinations
IMAGE_WIDTH=1200
IMAGE_HEIGHT=1200
# Only required when IMAGE_PROVIDER=huggingface
HUGGINGFACE_API_KEY=
HUGGINGFACE_IMAGE_MODEL=black-forest-labs/FLUX.1-schnell

# ---------------------------------------------------------------------------
# Telegram approval bot
# ---------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
# Numeric chat id of the person who approves posts. Message the bot, then open
# https://api.telegram.org/bot<TOKEN>/getUpdates to read it.
TELEGRAM_CHAT_ID=

# ---------------------------------------------------------------------------
# LinkedIn (3-legged OAuth 2.0 + Share on LinkedIn)
# ---------------------------------------------------------------------------
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=http://localhost:3000/oauth/linkedin/callback
# Versioned REST API date, format YYYYMM. LinkedIn supports each version for a
# minimum of one year, then sunsets it — a sunset version fails every call with a
# deprecation error. Check the latest at:
# https://learn.microsoft.com/en-us/linkedin/marketing/versioning
LINKEDIN_API_VERSION=202607

# ---------------------------------------------------------------------------
# Secrets at rest
# 32 bytes, hex encoded. Generate with: npm run keygen
# ---------------------------------------------------------------------------
TOKEN_ENCRYPTION_KEY=

# ---------------------------------------------------------------------------
# Scheduling & pipeline behaviour
# ---------------------------------------------------------------------------
# When the bot proposes the day's topics. Standard 5-field cron.
DAILY_CRON=0 9 * * *
TIMEZONE=Asia/Kolkata
# Number of hot topics offered each morning.
TOPIC_COUNT=5
# How many revision rounds a single draft may go through before the bot stops.
MAX_REVISIONS=8
# How many times a draft is auto-regenerated after failing safety moderation.
MODERATION_MAX_RETRIES=2
# Comma-separated Google News queries used to discover trending business topics.
NEWS_QUERIES=digital marketing,brand strategy,AI in marketing,advertising industry,B2B marketing
